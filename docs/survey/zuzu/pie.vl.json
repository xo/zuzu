{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 340,
  "height": 230,
  "data": {"url": "data/seattle-weather.csv"},
  "mark": "arc",
  "encoding": {
    "theta": {"aggregate": "count", "type": "quantitative"},
    "color": {"field": "weather", "type": "nominal", "sort": ["sun", "fog", "drizzle", "rain", "snow"]}
  },
  "view": {"stroke": null}
}
