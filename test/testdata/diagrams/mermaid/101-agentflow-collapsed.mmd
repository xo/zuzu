agentflow-beta TB
  flow intake["Intake"]
    receive["Receive request"]@{
      shape: input
      description: "The request of a user",
    }
  end

  flow processing["Processing"]
    validate["Validate"]@{ shape: task }
    enrich["Enrich"]@{ }
    validate --> enrich
  end
  processing@{ view: "collapsed" }

  flow output["Output"]
    publish["Publish"]@{ shape: action }
  end

  receive --> validate
  enrich --> publish
  enrich --x receive
