{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "The packages of Flare: three levels of the toolkit, from the root at the center.",
  "width": 560,
  "height": 480,
  "padding": 5,
  "title": {
    "text": "The packages of Flare",
    "subtitle": "Three levels of the toolkit, from the root at the center"
  },
  "signals": [
    {
      "name": "radius",
      "update": "min(width, height) / 2 - 10"
    }
  ],
  "data": [
    {
      "name": "tree",
      "url": "data/flare.json"
    },
    {
      "name": "flare",
      "url": "data/flare.json",
      "transform": [
        {
          "type": "lookup",
          "from": "tree",
          "key": "id",
          "fields": [
            "parent"
          ],
          "as": [
            "p1"
          ]
        },
        {
          "type": "lookup",
          "from": "tree",
          "key": "id",
          "fields": [
            "p1.parent"
          ],
          "as": [
            "p2"
          ]
        },
        {
          "type": "lookup",
          "from": "tree",
          "key": "id",
          "fields": [
            "p2.parent"
          ],
          "as": [
            "p3"
          ]
        },
        {
          "type": "lookup",
          "from": "tree",
          "key": "id",
          "fields": [
            "p3.parent"
          ],
          "as": [
            "p4"
          ]
        },
        {
          "type": "formula",
          "as": "top",
          "expr": "datum.parent === 1 ? datum.name : datum.p1 && datum.p1.parent === 1 ? datum.p1.name : datum.p2 && datum.p2.parent === 1 ? datum.p2.name : datum.p3 && datum.p3.parent === 1 ? datum.p3.name : datum.p4 && datum.p4.parent === 1 ? datum.p4.name : null"
        },
        {
          "type": "formula",
          "as": "level",
          "expr": "!isValid(datum.parent) ? 0 : !datum.p1 || !isValid(datum.p1.parent) ? 1 : !datum.p2 || !isValid(datum.p2.parent) ? 2 : !datum.p3 || !isValid(datum.p3.parent) ? 3 : !datum.p4 || !isValid(datum.p4.parent) ? 4 : 5"
        }
      ]
    },
    {
      "name": "tops",
      "source": "flare",
      "transform": [
        {
          "type": "filter",
          "expr": "isValid(datum.top)"
        }
      ]
    },
    {
      "name": "nodes",
      "source": "flare",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.level <= 3"
        },
        {
          "type": "stratify",
          "key": "id",
          "parentKey": "parent"
        },
        {
          "type": "tree",
          "method": "tidy",
          "size": [
            {
              "signal": "2 * PI"
            },
            {
              "signal": "radius"
            }
          ],
          "separation": true,
          "as": [
            "angle",
            "r",
            "depth",
            "children"
          ]
        },
        {
          "type": "formula",
          "as": "x",
          "expr": "width / 2 + datum.r * cos(datum.angle - PI / 2)"
        },
        {
          "type": "formula",
          "as": "y",
          "expr": "height / 2 + datum.r * sin(datum.angle - PI / 2)"
        }
      ]
    },
    {
      "name": "branches",
      "source": "nodes",
      "transform": [
        {
          "type": "treelinks"
        },
        {
          "type": "linkpath",
          "orient": "radial",
          "shape": "curve",
          "sourceX": "source.angle",
          "sourceY": "source.r",
          "targetX": "target.angle",
          "targetY": "target.r"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "color",
      "type": "ordinal",
      "domain": {
        "data": "tops",
        "field": "top",
        "sort": {
          "op": "sum",
          "field": "size",
          "order": "descending"
        }
      },
      "range": "category"
    }
  ],
  "legends": [
    {
      "fill": "color",
      "orient": "right"
    }
  ],
  "marks": [
    {
      "type": "path",
      "from": {
        "data": "branches"
      },
      "encode": {
        "enter": {
          "x": {
            "signal": "width / 2"
          },
          "y": {
            "signal": "height / 2"
          },
          "path": {
            "field": "path"
          },
          "stroke": {
            "scale": "color",
            "field": "target.top"
          },
          "strokeOpacity": {
            "value": 0.45
          },
          "strokeWidth": {
            "value": 1.2
          }
        }
      }
    },
    {
      "type": "symbol",
      "from": {
        "data": "nodes"
      },
      "encode": {
        "enter": {
          "x": {
            "field": "x"
          },
          "y": {
            "field": "y"
          },
          "size": {
            "signal": "datum.depth === 0 ? 100 : datum.depth === 1 ? 64 : 25"
          },
          "fill": [
            {
              "test": "datum.depth === 0",
              "value": "#1b2230"
            },
            {
              "scale": "color",
              "field": "top"
            }
          ],
          "stroke": {
            "value": "#ffffff"
          },
          "strokeWidth": {
            "value": 1
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "nodes"
      },
      "encode": {
        "enter": {
          "x": {
            "field": "x"
          },
          "y": {
            "field": "y",
            "offset": -8
          },
          "align": {
            "value": "center"
          },
          "fontWeight": {
            "value": 600
          },
          "text": {
            "signal": "datum.depth === 1 ? datum.name : ''"
          }
        }
      }
    }
  ]
}
