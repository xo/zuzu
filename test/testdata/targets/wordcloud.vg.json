{
  "$schema": "https://vega.github.io/schema/vega/v6.json",
  "description": "The largest classes of Flare: the 70 largest classes. The size of a name is the size of its source.",
  "width": 600,
  "height": 360,
  "padding": 5,
  "title": {
    "text": "The largest classes of Flare",
    "subtitle": "The 70 largest classes. The size of a name is the size of its source"
  },
  "data": [
    {
      "name": "tree",
      "url": "data/flare.json"
    },
    {
      "name": "flare",
      "url": "data/flare.json",
      "transform": [
        {
          "type": "lookup",
          "from": "tree",
          "key": "id",
          "fields": [
            "parent"
          ],
          "as": [
            "p1"
          ]
        },
        {
          "type": "lookup",
          "from": "tree",
          "key": "id",
          "fields": [
            "p1.parent"
          ],
          "as": [
            "p2"
          ]
        },
        {
          "type": "lookup",
          "from": "tree",
          "key": "id",
          "fields": [
            "p2.parent"
          ],
          "as": [
            "p3"
          ]
        },
        {
          "type": "lookup",
          "from": "tree",
          "key": "id",
          "fields": [
            "p3.parent"
          ],
          "as": [
            "p4"
          ]
        },
        {
          "type": "formula",
          "as": "top",
          "expr": "datum.parent === 1 ? datum.name : datum.p1 && datum.p1.parent === 1 ? datum.p1.name : datum.p2 && datum.p2.parent === 1 ? datum.p2.name : datum.p3 && datum.p3.parent === 1 ? datum.p3.name : datum.p4 && datum.p4.parent === 1 ? datum.p4.name : null"
        },
        {
          "type": "formula",
          "as": "level",
          "expr": "!isValid(datum.parent) ? 0 : !datum.p1 || !isValid(datum.p1.parent) ? 1 : !datum.p2 || !isValid(datum.p2.parent) ? 2 : !datum.p3 || !isValid(datum.p3.parent) ? 3 : !datum.p4 || !isValid(datum.p4.parent) ? 4 : 5"
        }
      ]
    },
    {
      "name": "tops",
      "source": "flare",
      "transform": [
        {
          "type": "filter",
          "expr": "isValid(datum.top)"
        }
      ]
    },
    {
      "name": "words",
      "source": "flare",
      "transform": [
        {
          "type": "filter",
          "expr": "isValid(datum.size)"
        },
        {
          "type": "window",
          "sort": {
            "field": "size",
            "order": "descending"
          },
          "ops": [
            "row_number"
          ],
          "as": [
            "rank"
          ]
        },
        {
          "type": "filter",
          "expr": "datum.rank <= 70"
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "color",
      "type": "ordinal",
      "domain": {
        "data": "tops",
        "field": "top",
        "sort": {
          "op": "sum",
          "field": "size",
          "order": "descending"
        }
      },
      "range": "category"
    }
  ],
  "marks": [
    {
      "type": "text",
      "from": {
        "data": "words"
      },
      "encode": {
        "enter": {
          "text": {
            "field": "name"
          },
          "align": {
            "value": "center"
          },
          "baseline": {
            "value": "alphabetic"
          },
          "fill": {
            "scale": "color",
            "field": "top"
          }
        }
      },
      "transform": [
        {
          "type": "wordcloud",
          "size": [
            {
              "signal": "width"
            },
            {
              "signal": "height"
            }
          ],
          "text": {
            "field": "text"
          },
          "fontSize": {
            "field": "datum.size"
          },
          "fontSizeRange": [
            10,
            40
          ],
          "fontWeight": {
            "value": 600
          },
          "padding": 2
        }
      ]
    }
  ]
}
