  Enterprise_Boundary(bank, "The bank") {
    Person(customer, "Customer", "A customer of the bank")
    System(banking, "Internet Banking", "Shows the accounts")
    System_Boundary(core, "Core") {
      SystemDb(mainframe, "Mainframe", "Holds the accounts")
      SystemQueue(events, "Events", "Carries the events")
    }
  }
  Person_Ext(visitor, "Visitor", "Reads the site")
  System_Ext(mail, "Mail", "Sends e-mail")
  SystemDb_Ext(archive, "Archive")
