gantt
    title A day in hours
    dateFormat YYYY-MM-DD HH:mm
    axisFormat %a %H:%M
    tickInterval 12hour
    excludes weekends
    section Shift
    morning  :2024-01-05 08:00, 4h
    lunch    :30m
    long     :2024-01-05 12:00, 25h
    late     :2024-01-05 20:00, 5h
    day      :2024-01-05 12:00, 1d
    half     :2024-01-04 20:00, 30h
