railroad-beta
title Expression Grammar
accTitle: Expressions
accDescr: The rules of an expression, in the notation of railroad-beta.

expression = sequence(
    nonterminal("term"),
    zeroOrMore(sequence(choice(terminal("+"), terminal("-")), nonterminal("term")))
) ;
term = sequence(nonterminal("factor"), optional(sequence(terminal("^"), nonterminal("term")))) ;
factor = choice(nonterminal("number"), sequence(terminal("("), nonterminal("expression"), terminal(")"))) ;
number = oneOrMore(nonterminal("digit")) ; /* a block comment */
digit = choice(terminal("0"), terminal("1"), special("any other digit")) ;
