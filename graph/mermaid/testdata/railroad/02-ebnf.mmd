title "JSON Grammar"

(* An ISO comment, and a block comment *) /* here */
json ::= element ;
element = object | array | string | number | "true" | "false" | "null" ;
object = "{" , [ member { "," member } ] , "}" ;
array = "[" [ element ( "," element )* ] "]" ;
member = string ":" element ;
string = '"' { character - '"' } '"' ;
character = ? any character ? ;
number = digit+ ;
