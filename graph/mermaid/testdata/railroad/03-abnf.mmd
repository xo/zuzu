railroad-abnf-beta
title "Email Address"
accDescr {
  An address of email,
  in the notation of ABNF.
}
address = local-part "@" domain ;
local-part = 1*( ALPHA / DIGIT / "." / "-" ) ;
domain = label *( "." label ) ;
label = 1*63( ALPHA / DIGIT / "-" ) [ "." ] ;
code = 3DIGIT *1%x2D ;
letter = %x41-5A / %x61-7A ;
